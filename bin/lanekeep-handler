#!/usr/bin/env bash
# shellcheck disable=SC1091,SC1090  # lib paths use $LANEKEEP_DIR — not resolvable statically
set -euo pipefail
trap '' PIPE

LANEKEEP_DIR="${LANEKEEP_DIR:?}"

# Fast JSON string escaper for known-schema internal data (replaces jq -n --arg)
_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Phase 1: Always-needed modules (config resolution, license tier)
source "$LANEKEEP_DIR/lib/config.sh"
source "$LANEKEEP_DIR/lib/license.sh"
resolve_license_tier

# Read request JSON from stdin — may be multi-line (pretty-printed from Claude Code)
RAW_INPUT=$(cat)

if [ -z "$RAW_INPUT" ]; then
  echo '{"decision":"deny","reason":"[LaneKeep] DENIED: Empty request"}'
  exit 0
fi

# Normalize, validate, and extract request fields in a single jq call (3→1 subprocess)
_REQ_EXTRACT=$(printf '%s' "$RAW_INPUT" | jq -r '
  if type != "object" then empty
  elif (has("tool_name") and has("tool_input")) | not then empty
  else
    "REQUEST=" + (tojson | @sh),
    "TOOL_NAME=" + (.tool_name // "" | @sh),
    "TOOL_INPUT=" + (.tool_input // {} | tojson | @sh),
    "TOOL_USE_ID=" + (.tool_use_id // "" | @sh),
    "HOOK_EVENT=" + (.hook_event_name // "PreToolUse" | @sh),
    "SESSION_ID=" + (.session_id // "" | @sh),
    "TRANSCRIPT_PATH=" + (.transcript_path // "" | @sh),
    "_TRACE_AGENT_ID=" + (.agent_id // "" | @sh),
    "_TRACE_PARENT_SESSION_ID=" + (.parent_session_id // "" | @sh),
    "_TRACE_SPAWNED_BY=" + (.spawned_by // "" | @sh),
    "_TRACE_AGENT_DEPTH=" + (if has("agent_depth") then .agent_depth | tostring else "" end | @sh),
    "_TRACE_AGENT_TYPE=" + (.agent_type // "" | @sh),
    "_TRACE_ISOLATION_TYPE=" + (.isolation_type // "" | @sh),
    "_TRACE_IS_BACKGROUND=" + (if .is_background == true then "true" elif .is_background == false then "false" else "" end | @sh)
  end' 2>/dev/null) || _REQ_EXTRACT=""

if [ -z "$_REQ_EXTRACT" ]; then
  echo '{"decision":"deny","reason":"[LaneKeep] DENIED: Malformed request or Missing required fields: tool_name, tool_input"}'
  exit 0
fi
eval "$_REQ_EXTRACT"

# AG-002/003: Set trace context vars for cc_session_id and agent metadata
_TRACE_CC_SESSION_ID="$SESSION_ID"

# Truncate agent metadata to prevent resource exhaustion from malicious input
[[ ${#_TRACE_CC_SESSION_ID} -le 256 ]] || _TRACE_CC_SESSION_ID="${_TRACE_CC_SESSION_ID:0:256}"
[[ ${#_TRACE_AGENT_ID} -le 128 ]] || _TRACE_AGENT_ID="${_TRACE_AGENT_ID:0:128}"
[[ ${#_TRACE_PARENT_SESSION_ID} -le 128 ]] || _TRACE_PARENT_SESSION_ID="${_TRACE_PARENT_SESSION_ID:0:128}"
[[ ${#_TRACE_SPAWNED_BY} -le 128 ]] || _TRACE_SPAWNED_BY="${_TRACE_SPAWNED_BY:0:128}"
[[ ${#_TRACE_AGENT_TYPE} -le 64 ]] || _TRACE_AGENT_TYPE="${_TRACE_AGENT_TYPE:0:64}"
[[ ${#_TRACE_ISOLATION_TYPE} -le 32 ]] || _TRACE_ISOLATION_TYPE="${_TRACE_ISOLATION_TYPE:0:32}"
[[ "${_TRACE_AGENT_DEPTH:-}" =~ ^[0-9]+$ ]] || _TRACE_AGENT_DEPTH=""

# P1: Pre-extract all config flags in one jq call
# Eliminates ~8 downstream jq calls that each parse the full config
_CFG_RULES_COUNT=0
_CFG_HAS_POLICIES="false"
_CFG_MAX_ACTIONS=""
_CFG_TIMEOUT_SECONDS=""
_CFG_MAX_TOKENS=""
_CFG_PLUGIN_HASHES=""
_CFG_PLUGIN_TIMEOUT="5"
_CFG_MAX_INPUT_TOKENS=""
_CFG_MAX_OUTPUT_TOKENS=""
_CFG_MAX_TOTAL_ACTIONS=""
_CFG_MAX_TOTAL_INPUT_TOKENS=""
_CFG_MAX_TOTAL_OUTPUT_TOKENS=""
_CFG_MAX_TOTAL_TOKENS=""
_CFG_MAX_TOTAL_TIME=""
_CFG_MAX_COST=""
_CFG_MAX_TOTAL_COST=""
_CFG_MAX_TASK_ACTIONS=""
_CFG_MAX_TASK_INPUT_TOKENS=""
_CFG_MAX_TASK_OUTPUT_TOKENS=""
_CFG_MAX_TASK_TOKENS=""
_CFG_MAX_TASK_TIME=""
_CFG_MAX_TASK_COST=""
_CFG_HIDDEN_TEXT_ENABLED="true"
_CFG_INPUT_PII_ENABLED="true"
_CFG_RESULT_TRANSFORM_ENABLED="true"
_CFG_SEMANTIC_ENABLED="true"
# Hardblock arrays (newline-separated — safe for substrings and single-line regex)
_CFG_HARD_BLOCKS=""
_CFG_HARD_BLOCKS_REGEX=""
_CFG_HARD_BLOCK_OVERRIDES=""
# Hidden text evaluator config (RS-delimited for pattern arrays)
_CFG_HT_ANSI_ENABLED="true"
_CFG_HT_ANSI_PATTERNS=""
_CFG_HT_ANSI_DECISION="deny"
_CFG_HT_CSS_ENABLED="true"
_CFG_HT_CSS_PATTERNS=""
_CFG_HT_CSS_DECISION="ask"
_CFG_HT_HTML_ENABLED="true"
_CFG_HT_HTML_PATTERNS=""
_CFG_HT_HTML_DECISION="ask"
# Workflow injection evaluator config
_CFG_WORKFLOW_INJECT_ENABLED="true"
# Repo content injection evaluator config (Tier 2.5.5)
_CFG_RI_ENABLED="true"
_CFG_RI_MAX_SCAN_BYTES="262144"
_CFG_RI_INCLUDE_EXTS=""
_CFG_RI_ALWAYS_BASENAMES=""
_CFG_RI_ALWAYS_PATHS=""
_CFG_RI_SKIP_PATHS=""
_CFG_RI_AUTHORITY_ENABLED="true"; _CFG_RI_AUTHORITY_DECISION="warn"; _CFG_RI_AUTHORITY_PATTERNS=""
_CFG_RI_ROLE_ENABLED="true";      _CFG_RI_ROLE_DECISION="warn";      _CFG_RI_ROLE_PATTERNS=""
_CFG_RI_FORCING_ENABLED="true";   _CFG_RI_FORCING_DECISION="ask";    _CFG_RI_FORCING_PATTERNS=""
_CFG_RI_ENCODED_ENABLED="true";   _CFG_RI_ENCODED_DECISION="ask";    _CFG_RI_ENCODED_PATTERNS=""
_CFG_RI_INVIS_ENABLED="true";     _CFG_RI_INVIS_DECISION="deny";     _CFG_RI_INVIS_PATTERNS=""
_CFG_RI_MEMORY_ENABLED="true";    _CFG_RI_MEMORY_DECISION="warn";    _CFG_RI_MEMORY_PATTERNS=""
# Session write-then-execute evaluator config (Tier 2.1)
_CFG_SESSION_WRITE_EXEC_ENABLED="true"
_CFG_SESSION_WRITE_EXEC_SURFACE_AS="info"
_CFG_SESSION_WRITE_EXEC_EXCLUDE_EXTS=".md .json .yaml .yml .txt"
# Context budget evaluator config
_CFG_CONTEXT_BUDGET_ENABLED="false"
_CFG_CONTEXT_WINDOW_SIZE=""
_CFG_CONTEXT_SOFT_PERCENT=""
_CFG_CONTEXT_HARD_PERCENT=""
_CFG_CONTEXT_BUDGET_DECISION=""
_CFG_CONTEXT_ACTION_WARN=""
_CFG_CONTEXT_ACTION_HARD=""
# Multi-session evaluator config
_CFG_MULTI_SESSION_ENABLED="false"
_CFG_MULTI_DENY_RATE=""
_CFG_MULTI_TOOL_DENY=""
_CFG_MULTI_COST_WARN=""
_CFG_MULTI_MIN_SESSIONS=""
# Input PII evaluator config
_CFG_INPUT_PII_ON_DETECT="ask"
_CFG_INPUT_PII_PATTERNS=""
_CFG_INPUT_PII_COMPLIANCE="[]"
_CFG_INPUT_PII_HAS_TOOLS="false"
_CFG_INPUT_PII_TOOLS=""
_CFG_INPUT_PII_ALLOWLIST=""
# Headless escalation sink (rewrites ask -> deny when LANEKEEP_HEADLESS=1)
_CFG_HEADLESS_DIR=""
_CFG_HEADLESS_TAIL="20"
# MCP inventory policy (gates the distinct-tool count pre-query in policies_check)
_CFG_MCP_INVENTORY_ENABLED="false"
# Scope containment evaluator (Tier 0.6)
_CFG_SCOPE_ENABLED="true"
_CFG_SCOPE_DECISION="deny"
_CFG_SCOPE_ALLOWED_PATHS=""
# Cumulative risk scoring (session-scoped warn/ask escalation)
_CFG_RISK_ENABLED="false"
_CFG_RISK_WARN_THRESHOLD=""
_CFG_RISK_ASK_THRESHOLD=""
if [ -f "${LANEKEEP_CONFIG_FILE:-}" ]; then
  eval "$(jq -r '
    "_CFG_RULES_COUNT=" + (.rules | length | tostring | @sh),
    "_CFG_HAS_POLICIES=" + (if has("policies") and (.policies | length > 0) then "true" else "false" end | @sh),
    "_CFG_MAX_ACTIONS=" + (.budget.max_actions // "" | tostring | @sh),
    "_CFG_TIMEOUT_SECONDS=" + (.budget.timeout_seconds // "" | tostring | @sh),
    "_CFG_MAX_TOKENS=" + (.budget.max_tokens // "" | tostring | @sh),
    "_CFG_MAX_INPUT_TOKENS=" + (.budget.max_input_tokens // "" | tostring | @sh),
    "_CFG_MAX_OUTPUT_TOKENS=" + (.budget.max_output_tokens // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_ACTIONS=" + (.budget.max_total_actions // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_INPUT_TOKENS=" + (.budget.max_total_input_tokens // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_OUTPUT_TOKENS=" + (.budget.max_total_output_tokens // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_TOKENS=" + (.budget.max_total_tokens // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_TIME=" + (.budget.max_total_time_seconds // "" | tostring | @sh),
    "_CFG_MAX_COST=" + (.budget.max_cost // "" | tostring | @sh),
    "_CFG_MAX_TOTAL_COST=" + (.budget.max_total_cost // "" | tostring | @sh),
    "_CFG_MAX_TASK_ACTIONS=" + (.budget.max_task_actions // "" | tostring | @sh),
    "_CFG_MAX_TASK_INPUT_TOKENS=" + (.budget.max_task_input_tokens // "" | tostring | @sh),
    "_CFG_MAX_TASK_OUTPUT_TOKENS=" + (.budget.max_task_output_tokens // "" | tostring | @sh),
    "_CFG_MAX_TASK_TOKENS=" + (.budget.max_task_tokens // "" | tostring | @sh),
    "_CFG_MAX_TASK_TIME=" + (.budget.max_task_time_seconds // "" | tostring | @sh),
    "_CFG_MAX_TASK_COST=" + (.budget.max_task_cost // "" | tostring | @sh),
    "_CFG_PLUGIN_HASHES=" + ((.plugins.allowed_hashes // {} | to_entries | map("\(.key)=\(.value)") | join(";")) | @sh),
    "_CFG_PLUGIN_CRASH_POLICY=" + ((.plugins.crash_policy // "deny") | @sh),
    "_CFG_PLUGIN_TIMEOUT=" + ((.plugins.timeout // 5) | tostring | @sh),
    "_CFG_HIDDEN_TEXT_ENABLED=" + (if .evaluators.hidden_text.enabled == false then "false" else "true" end | @sh),
    "_CFG_INPUT_PII_ENABLED=" + (if .evaluators.input_pii.enabled == false then "false" else "true" end | @sh),
    "_CFG_RESULT_TRANSFORM_ENABLED=" + (if .evaluators.result_transform.enabled == false then "false" else "true" end | @sh),
    "_CFG_SEMANTIC_ENABLED=" + (if .evaluators.semantic.enabled == false then "false" else "true" end | @sh),
    "_CFG_WORKFLOW_INJECT_ENABLED=" + (if .evaluators.workflow_injection.enabled == false then "false" else "true" end | @sh),
    # -- Repo content injection evaluator (Tier 2.5.5) --
    "_CFG_RI_ENABLED=" + (if .evaluators.repo_injection.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_MAX_SCAN_BYTES=" + (.evaluators.repo_injection.max_scan_bytes // 262144 | tostring | @sh),
    "_CFG_RI_INCLUDE_EXTS=" + (.evaluators.repo_injection.include_extensions // [] | join("\u001e") | @sh),
    "_CFG_RI_ALWAYS_BASENAMES=" + (.evaluators.repo_injection.always_scan_basenames // [] | join("\u001e") | @sh),
    "_CFG_RI_ALWAYS_PATHS=" + (.evaluators.repo_injection.always_scan_paths // [] | join("\u001e") | @sh),
    "_CFG_RI_SKIP_PATHS=" + (.evaluators.repo_injection.skip_paths // [] | join("\u001e") | @sh),
    "_CFG_RI_AUTHORITY_ENABLED=" + (if .evaluators.repo_injection.classes.authority_injection.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_AUTHORITY_DECISION=" + (.evaluators.repo_injection.classes.authority_injection.decision // "warn" | @sh),
    "_CFG_RI_AUTHORITY_PATTERNS=" + (.evaluators.repo_injection.classes.authority_injection.patterns // [] | join("\u001e") | @sh),
    "_CFG_RI_ROLE_ENABLED=" + (if .evaluators.repo_injection.classes.role_reset.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_ROLE_DECISION=" + (.evaluators.repo_injection.classes.role_reset.decision // "warn" | @sh),
    "_CFG_RI_ROLE_PATTERNS=" + (.evaluators.repo_injection.classes.role_reset.patterns // [] | join("\u001e") | @sh),
    "_CFG_RI_FORCING_ENABLED=" + (if .evaluators.repo_injection.classes.tool_forcing.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_FORCING_DECISION=" + (.evaluators.repo_injection.classes.tool_forcing.decision // "ask" | @sh),
    "_CFG_RI_FORCING_PATTERNS=" + (.evaluators.repo_injection.classes.tool_forcing.patterns // [] | join("\u001e") | @sh),
    "_CFG_RI_ENCODED_ENABLED=" + (if .evaluators.repo_injection.classes.encoded_payload.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_ENCODED_DECISION=" + (.evaluators.repo_injection.classes.encoded_payload.decision // "ask" | @sh),
    "_CFG_RI_ENCODED_PATTERNS=" + (.evaluators.repo_injection.classes.encoded_payload.patterns // [] | join("\u001e") | @sh),
    "_CFG_RI_INVIS_ENABLED=" + (if .evaluators.repo_injection.classes.invisible_char.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_INVIS_DECISION=" + (.evaluators.repo_injection.classes.invisible_char.decision // "deny" | @sh),
    "_CFG_RI_INVIS_PATTERNS=" + (.evaluators.repo_injection.classes.invisible_char.patterns // [] | join("\u001e") | @sh),
    "_CFG_RI_MEMORY_ENABLED=" + (if .evaluators.repo_injection.classes.memory_poison.enabled == false then "false" else "true" end | @sh),
    "_CFG_RI_MEMORY_DECISION=" + (.evaluators.repo_injection.classes.memory_poison.decision // "warn" | @sh),
    "_CFG_RI_MEMORY_PATTERNS=" + (.evaluators.repo_injection.classes.memory_poison.patterns // [] | join("\u001e") | @sh),
    # -- Session write-then-execute evaluator (Tier 2.1) --
    "_CFG_SESSION_WRITE_EXEC_ENABLED=" + (if .evaluators.session_write_exec.enabled == false then "false" else "true" end | @sh),
    "_CFG_SESSION_WRITE_EXEC_SURFACE_AS=" + (.evaluators.session_write_exec.surface_as // "info" | @sh),
    "_CFG_SESSION_WRITE_EXEC_EXCLUDE_EXTS=" + ((.evaluators.session_write_exec.exclude_extensions // [".md", ".json", ".yaml", ".yml", ".txt"]) | join(" ") | @sh),
    # -- Context budget evaluator --
    "_CFG_CONTEXT_BUDGET_ENABLED=" + (if .evaluators.context_budget.enabled == false then "false" else "true" end | @sh),
    "_CFG_CONTEXT_WINDOW_SIZE=" + (.budget.context_window_size // "" | tostring | @sh),
    "_CFG_CONTEXT_SOFT_PERCENT=" + (.budget.context_soft_percent // "" | tostring | @sh),
    "_CFG_CONTEXT_HARD_PERCENT=" + (.budget.context_hard_percent // "" | tostring | @sh),
    "_CFG_CONTEXT_BUDGET_DECISION=" + (.evaluators.context_budget.decision // "ask" | @sh),
    "_CFG_CONTEXT_ACTION_WARN=" + (.budget.action_count_warn // "" | tostring | @sh),
    "_CFG_CONTEXT_ACTION_HARD=" + (.budget.action_count_hard // "" | tostring | @sh),
    # -- Multi-session evaluator --
    "_CFG_MULTI_SESSION_ENABLED=" + (if .evaluators.multi_session.enabled == false then "false" else "true" end | @sh),
    "_CFG_MULTI_DENY_RATE=" + (.evaluators.multi_session.deny_rate_threshold // "" | tostring | @sh),
    "_CFG_MULTI_TOOL_DENY=" + (.evaluators.multi_session.tool_deny_threshold // "" | tostring | @sh),
    "_CFG_MULTI_COST_WARN=" + (.evaluators.multi_session.cost_warn_percent // "" | tostring | @sh),
    "_CFG_MULTI_MIN_SESSIONS=" + (.evaluators.multi_session.min_sessions // "" | tostring | @sh),
    # -- Hardblock arrays (newline-separated) --
    "_CFG_HARD_BLOCKS=" + (.hard_blocks // [] | join("\n") | @sh),
    "_CFG_HARD_BLOCKS_REGEX=" + (.hard_blocks_regex // [] | join("\n") | @sh),
    "_CFG_HARD_BLOCK_OVERRIDES=" + (.hard_block_overrides // {} | to_entries | map("\(.key)=\(.value)") | join("\n") | @sh),
    # -- Hidden text evaluator (RS \x1e delimiter for pattern arrays) --
    "_CFG_HT_ANSI_ENABLED=" + (if .evaluators.hidden_text.ansi.enabled == false then "false" else "true" end | @sh),
    "_CFG_HT_ANSI_PATTERNS=" + (.evaluators.hidden_text.ansi.patterns // [] | join("\u001e") | @sh),
    "_CFG_HT_ANSI_DECISION=" + (.evaluators.hidden_text.ansi.decision // "deny" | @sh),
    "_CFG_HT_CSS_ENABLED=" + (if .evaluators.hidden_text.css_hiding.enabled == false then "false" else "true" end | @sh),
    "_CFG_HT_CSS_PATTERNS=" + (.evaluators.hidden_text.css_hiding.patterns // [] | join("\u001e") | @sh),
    "_CFG_HT_CSS_DECISION=" + (.evaluators.hidden_text.css_hiding.decision // "ask" | @sh),
    "_CFG_HT_HTML_ENABLED=" + (if .evaluators.hidden_text.html_injection.enabled == false then "false" else "true" end | @sh),
    "_CFG_HT_HTML_PATTERNS=" + (.evaluators.hidden_text.html_injection.patterns // [] | join("\u001e") | @sh),
    "_CFG_HT_HTML_DECISION=" + (.evaluators.hidden_text.html_injection.decision // "ask" | @sh),
    # -- Input PII evaluator --
    "_CFG_INPUT_PII_ON_DETECT=" + (.evaluators.input_pii.on_detect // "ask" | @sh),
    "_CFG_INPUT_PII_PATTERNS=" + ((.evaluators.input_pii.pii_patterns // .evaluators.result_transform.pii_patterns // []) | join("\u001e") | @sh),
    "_CFG_INPUT_PII_COMPLIANCE=" + (.evaluators.input_pii.compliance_by_category.pii // .evaluators.result_transform.compliance_by_category.pii // [] | tojson | @sh),
    "_CFG_INPUT_PII_HAS_TOOLS=" + (if (.evaluators.input_pii | has("tools")) and (.evaluators.input_pii.tools | length > 0) then "true" else "false" end | @sh),
    "_CFG_INPUT_PII_TOOLS=" + (.evaluators.input_pii.tools // [] | join(",") | @sh),
    "_CFG_MCP_INVENTORY_ENABLED=" + (if .policies.mcp_inventory.enabled == true then "true" else "false" end | @sh),
    "_CFG_INPUT_PII_ALLOWLIST=" + ((.evaluators.input_pii.pii_allowlist // []) | join("\u001e") | @sh),
    "_CFG_HEADLESS_DIR=" + (.headless.escalation_dir // "" | @sh),
    "_CFG_HEADLESS_TAIL=" + (.headless.include_trace_tail_lines // 20 | tostring | @sh),
    "_CFG_SCOPE_ENABLED=" + (if .evaluators.scope_containment.enabled == false then "false" else "true" end | @sh),
    "_CFG_SCOPE_DECISION=" + (.evaluators.scope_containment.decision // "deny" | @sh),
    "_CFG_RISK_ENABLED=" + (if .evaluators.risk_score.enabled == true then "true" else "false" end | @sh),
    "_CFG_RISK_WARN_THRESHOLD=" + (.evaluators.risk_score.warn_threshold // "" | tostring | @sh),
    "_CFG_RISK_ASK_THRESHOLD=" + (.evaluators.risk_score.ask_threshold // "" | tostring | @sh)
  ' "$LANEKEEP_CONFIG_FILE" 2>/dev/null)" || true
fi

# Phase 2: Always-needed pipeline modules
source "$LANEKEEP_DIR/lib/dispatcher.sh"
source "$LANEKEEP_DIR/lib/trace.sh"
source "$LANEKEEP_DIR/lib/cumulative.sh"
source "$LANEKEEP_DIR/lib/headless.sh"
source "$LANEKEEP_DIR/lib/eval-rules.sh"
source "$LANEKEEP_DIR/lib/eval-budget.sh"
source "$LANEKEEP_DIR/lib/eval-schema.sh"
if [ "$_CFG_SCOPE_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-scope-containment.sh"
fi
# Tier 0.7: cwd == WORKTREE_ROOT invariant (advisory-only rollout).
# Always sourced — the evaluator no-ops when WORKTREE_ROOT is unset, which
# is the default for non-looper sessions.
source "$LANEKEEP_DIR/lib/eval-worktree-cwd.sh"

# Phase 3: Conditionally source evaluator modules based on config flags
# Hardblock always runs as a non-optional pre-filter (Finding 2: security parity)
source "$LANEKEEP_DIR/lib/eval-hardblock.sh"
if ! rules_enabled 2>/dev/null; then
  source "$LANEKEEP_DIR/lib/eval-codediff.sh"
fi
if [ "$_CFG_HIDDEN_TEXT_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-hidden-text.sh"
fi
if [ "$_CFG_INPUT_PII_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-input-pii.sh"
fi
if [ "$_CFG_SEMANTIC_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-semantic.sh"
fi
if [ "$_CFG_WORKFLOW_INJECT_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-workflow-injection.sh"
fi
if [ "$_CFG_RI_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-repo-injection.sh"
fi
if [ "$_CFG_RESULT_TRANSFORM_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-result-transform.sh"
fi
if [ "$_CFG_CONTEXT_BUDGET_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-context-budget.sh"
fi
if [ "$_CFG_MULTI_SESSION_ENABLED" != "false" ]; then
  source "$LANEKEEP_DIR/lib/eval-multi-session.sh"
fi

# Enterprise evaluators: source ee/lib/eval-*.sh (enterprise tier only)
if [ "${LANEKEEP_LICENSE_TIER:-community}" = "enterprise" ]; then
  for _ee_eval in "$LANEKEEP_DIR/ee/lib"/eval-*.sh; do
    [ -f "$_ee_eval" ] && [ ! -L "$_ee_eval" ] && source "$_ee_eval"
  done
  unset _ee_eval
fi

# Phase 4: Capture all timestamp forms at once (1B — one date per request)
# Use EPOCHREALTIME (bash 5.0+ builtin) for nanosecond precision — no subprocess
_epoch_real=$EPOCHREALTIME              # e.g. "1774741621.904575"
_NOW_EPOCH=${_epoch_real%.*}            # integer seconds
_usec=${_epoch_real#*.}                 # microseconds (6 digits)
_NOW_NS="${_NOW_EPOCH}${_usec}000"      # nanoseconds (pad to 9 digits)
START_NS=$_NOW_NS
TZ=UTC printf -v _NOW_ISO '%(%Y-%m-%dT%H:%M:%S)T' "$_NOW_EPOCH"
_ms_part=$(( 10#$_usec / 1000 ))
printf -v _ms3 '%03d' "$_ms_part"
_NOW_ISO="${_NOW_ISO}.${_ms3}Z"

case "$HOOK_EVENT" in
  PreToolUse)
    # === EXISTING TIER 0-8 PIPELINE ===

    RESULTS=()
    BLOCKED=false
    BLOCK_REASON=""
    BLOCK_HINT=""           # agent_hint: short model-targeted directive (deny/ask only)
    BLOCK_DECISION="deny"  # "deny" or "ask"
    WARN_REASON=""          # warn: allow but inject context

    # --- Tier 0: Config integrity ---
    if ! verify_config_integrity; then
      BLOCKED=true
      BLOCK_REASON="$INTEGRITY_REASON"
      RESULTS+=("$(printf '{"name":"ConfigIntegrity","tier":0,"score":1.0,"passed":false,"detail":"%s"}' "$(_json_escape "$INTEGRITY_REASON")")")
    fi

    # --- Tier 0.5: Schema (TaskSpec access control — check before content scanners) ---
    if [ "$BLOCKED" = false ]; then
      if ! schema_eval "$TOOL_NAME"; then
        BLOCKED=true
        BLOCK_REASON="$SCHEMA_REASON"
        BLOCK_DECISION="deny"
      fi
      _se_score=1; [ "$SCHEMA_PASSED" = true ] && _se_score=0
      RESULTS+=("$(printf '{"name":"SchemaEvaluator","tier":0.5,"score":%d,"passed":%s,"detail":"%s"}' \
        "$_se_score" "$SCHEMA_PASSED" "$(_json_escape "$SCHEMA_REASON")")")
    fi

    # --- Tier 0.6: Scope containment (TaskSpec allowed_paths) ---
    # Opt-in — no-op unless the TaskSpec declares .allowed_paths. Denies
    # Write/Edit outside declared paths and destructive Bash commands
    # (rm/mv/truncate/dd/shred/wipe/unlink and find … -delete) targeting
    # paths outside scope. Compliance: OWASP-ASI02, CWE-73.
    if [ "$BLOCKED" = false ] && [ "$_CFG_SCOPE_ENABLED" != "false" ]; then
      if declare -f scope_containment_eval >/dev/null 2>&1; then
        if ! scope_containment_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          BLOCKED=true
          BLOCK_REASON="$SCOPE_REASON"
          BLOCK_DECISION="$SCOPE_DECISION"
        fi
        _sc_score="0.9"; [ "$SCOPE_PASSED" = true ] && _sc_score="0"
        RESULTS+=("$(printf '{"name":"ScopeContainmentEvaluator","tier":0.6,"score":%s,"passed":%s,"detail":"%s","compliance":["OWASP-ASI02","CWE-73"]}' \
          "$_sc_score" "$SCOPE_PASSED" "$(_json_escape "$SCOPE_REASON")")")
      fi
    fi

    # --- Tier 0.7: cwd == WORKTREE_ROOT invariant (ADVISORY-ONLY) ---
    # Symphony §9.5. Denies (in a follow-up rollout) cwd-sensitive tool
    # calls when realpath($PWD) != realpath($WORKTREE_ROOT). Today the
    # evaluator always returns 0 and this branch only records the finding
    # so a week of production data can validate the invariant before we
    # flip to enforcement. Skips entirely when WORKTREE_ROOT is unset
    # (non-looper sessions).
    if declare -f worktree_cwd_eval >/dev/null 2>&1; then
      worktree_cwd_eval "$TOOL_NAME" "$TOOL_INPUT" || true
      _wc_score="0"; [ "$WORKTREE_CWD_PASSED" = false ] && _wc_score="0.5"
      RESULTS+=("$(printf '{"name":"WorktreeCwdEvaluator","tier":0.7,"score":%s,"passed":%s,"detail":"%s","advisory":true}' \
        "$_wc_score" "$WORKTREE_CWD_PASSED" "$(_json_escape "$WORKTREE_CWD_REASON")")")
    fi

    # --- Tier 1: Hardblock (always runs — input normalization + substring match) ---
    if [ "$BLOCKED" = false ]; then
      if ! hardblock_check "$TOOL_NAME" "$TOOL_INPUT"; then
        BLOCKED=true
        BLOCK_REASON="$HARDBLOCK_REASON"
        BLOCK_HINT="${HARDBLOCK_HINT:-}"
        RESULTS+=("$(printf '{"name":"HardBlock","tier":1,"score":1.0,"passed":false,"detail":"%s"}' "$(_json_escape "$BLOCK_REASON")")")
      fi
    fi

    # --- Tier 2: Rules engine OR legacy codediff ---
    if rules_enabled; then
      # Unified decision table (content-aware rules)
      if [ "$BLOCKED" = false ]; then
        if ! rules_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          if [ "$RULES_DECISION" = "ask" ]; then
            # "ask" doesn't block — let later tiers run, then escalate
            BLOCK_DECISION="ask"
            BLOCK_REASON="$RULES_REASON"
            BLOCK_HINT="${RULES_HINT:-}"
          else
            BLOCKED=true
            BLOCK_REASON="$RULES_REASON"
            BLOCK_HINT="${RULES_HINT:-}"
            BLOCK_DECISION="$RULES_DECISION"
          fi
        elif [ "$RULES_DECISION" = "warn" ]; then
          WARN_REASON="$RULES_REASON"
        fi
      fi
      _re_score=1; _re_intent=""
      [ "$RULES_PASSED" = true ] && _re_score=0
      [ -n "$RULES_INTENT" ] && _re_intent="$(printf ',"intent":"%s"' "$(_json_escape "$RULES_INTENT")")"
      RESULTS+=("$(printf '{"name":"RuleEngine","tier":2,"score":%d,"passed":%s,"detail":"%s","compliance":%s,"compliance_tags":%s%s}' \
        "$_re_score" "$RULES_PASSED" "$(_json_escape "$RULES_REASON")" "$RULES_COMPLIANCE" "$RULES_COMPLIANCE_TAGS" "$_re_intent")")
    else
      # Legacy: codediff only (hardblock now runs unconditionally at Tier 1)
      if [ "$BLOCKED" = false ]; then
        if ! codediff_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          BLOCKED=true
          BLOCK_REASON="$CODEDIFF_REASON"
          BLOCK_DECISION="$CODEDIFF_DECISION"
        fi
        _cd_score="0.9"; [ "$CODEDIFF_PASSED" = true ] && _cd_score="0"
        RESULTS+=("$(printf '{"name":"CodeDiffEvaluator","tier":2,"score":%s,"passed":%s,"detail":"%s"}' \
          "$_cd_score" "$CODEDIFF_PASSED" "$(_json_escape "$CODEDIFF_REASON")")")
      fi
    fi

    # --- Tier 2.1: Session write-then-execute detection ---
    # If a Bash command references a file written earlier in this session,
    # surface a warning/info — the file content was not re-scanned at exec time.
    if [ "$BLOCKED" = false ] && [ "$TOOL_NAME" = "Bash" ] && \
       [ "$_CFG_SESSION_WRITE_EXEC_ENABLED" != "false" ]; then
      SESSION_WRITE_EXEC_EXCLUDE_EXTS="$_CFG_SESSION_WRITE_EXEC_EXCLUDE_EXTS" \
        check_session_written_file "$TOOL_NAME" "$TOOL_INPUT"
      if [ "$SESSION_WRITE_EXEC_MATCHED" = true ]; then
        if [ "$_CFG_SESSION_WRITE_EXEC_SURFACE_AS" = "warn" ]; then
          _wte_label="WARNING"
        else
          _wte_label="INFO"
        fi
        _wte_reason="[LaneKeep] ${_wte_label} — Write-then-execute detected (Tier 2.1)
File '$SESSION_WRITE_EXEC_FILE' was written earlier in this session and is now being executed.
Executing session-written files bypasses content-level evaluation at runtime.

Compliance: CWE-78 (OS Command Injection), ATT&CK T1059.004"
        RESULTS+=("$(printf '{"name":"SessionWriteExecDetector","tier":2.1,"score":0.5,"passed":true,"detail":"%s","compliance_tags":["cwe:78","attck:t1059.004"]}' \
          "$(_json_escape "$_wte_reason")")")
        if [ -n "$WARN_REASON" ]; then
          WARN_REASON="${WARN_REASON}; ${_wte_reason}"
        else
          WARN_REASON="$_wte_reason"
        fi
      fi
    fi

    # --- Tier 2.5: Workflow expression injection (GitHub Actions ${{ }} in run: steps) ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_WORKFLOW_INJECT_ENABLED" != "false" ]; then
      if declare -f workflow_inject_eval >/dev/null 2>&1; then
        if ! workflow_inject_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          BLOCKED=true
          BLOCK_REASON="$WORKFLOW_INJECT_REASON"
          BLOCK_DECISION="$WORKFLOW_INJECT_DECISION"
        fi
        _wi_score="0.9"; [ "$WORKFLOW_INJECT_PASSED" = true ] && _wi_score="0"
        RESULTS+=("$(printf '{"name":"WorkflowInjectionEvaluator","tier":2.5,"score":%s,"passed":%s,"detail":"%s"}' \
          "$_wi_score" "$WORKFLOW_INJECT_PASSED" "$(_json_escape "$WORKFLOW_INJECT_REASON")")")
      fi
    fi

    # --- Tier 2.5.5: Repo content injection (scan Read/Bash-fetch target files) ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_RI_ENABLED" != "false" ]; then
      if declare -f repo_injection_eval >/dev/null 2>&1; then
        if ! repo_injection_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          BLOCKED=true
          BLOCK_REASON="$REPO_INJECT_REASON"
          BLOCK_DECISION="$REPO_INJECT_DECISION"
        fi
        _ri_score="0.85"; [ "$REPO_INJECT_PASSED" = true ] && _ri_score="0"
        RESULTS+=("$(printf '{"name":"RepoInjectionEvaluator","tier":2.55,"score":%s,"passed":%s,"detail":"%s","compliance":["OWASP-ASI01","OWASP-ASI06","CWE-1039"]}' \
          "$_ri_score" "$REPO_INJECT_PASSED" "$(_json_escape "$REPO_INJECT_REASON")")")
      fi
    fi

    # --- Tier 3: Hidden text (CSS/ANSI/HTML injection) ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_HIDDEN_TEXT_ENABLED" != "false" ]; then
      if ! hidden_text_eval "$TOOL_NAME" "$TOOL_INPUT"; then
        BLOCKED=true
        BLOCK_REASON="$HIDDEN_TEXT_REASON"
        BLOCK_DECISION="$HIDDEN_TEXT_DECISION"
      fi
      _ht_score="0.9"; [ "$HIDDEN_TEXT_PASSED" = true ] && _ht_score="0"
      RESULTS+=("$(printf '{"name":"HiddenTextEvaluator","tier":3,"score":%s,"passed":%s,"detail":"%s"}' \
        "$_ht_score" "$HIDDEN_TEXT_PASSED" "$(_json_escape "$HIDDEN_TEXT_REASON")")")
    fi

    # --- Tier 4: Input PII ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_INPUT_PII_ENABLED" != "false" ]; then
      if ! input_pii_eval "$TOOL_NAME" "$TOOL_INPUT"; then
        if [ "$INPUT_PII_DECISION" = "ask" ] && [ "$BLOCK_DECISION" = "ask" ]; then
          # Aggregate "ask" reasons from multiple tiers
          BLOCK_REASON="${BLOCK_REASON}; ${INPUT_PII_REASON}"
          [ -z "$BLOCK_HINT" ] && BLOCK_HINT="${INPUT_PII_HINT:-}"
          BLOCKED=true
        else
          BLOCKED=true
          BLOCK_REASON="$INPUT_PII_REASON"
          BLOCK_HINT="${INPUT_PII_HINT:-}"
          BLOCK_DECISION="$INPUT_PII_DECISION"
        fi
      elif [ "$INPUT_PII_DECISION" = "warn" ] && [ -n "$INPUT_PII_REASON" ] && [ "$INPUT_PII_REASON" != "Passed" ]; then
        WARN_REASON="$INPUT_PII_REASON"
      fi
      _ip_score="0.9"; [ "$INPUT_PII_PASSED" = true ] && _ip_score="0"
      RESULTS+=("$(printf '{"name":"InputPII","tier":4,"score":%s,"passed":%s,"detail":"%s","compliance":%s,"detections":%s}' \
        "$_ip_score" "$INPUT_PII_PASSED" "$(_json_escape "$INPUT_PII_REASON")" "$INPUT_PII_COMPLIANCE" "$INPUT_PII_DETECTIONS")")
    fi

    # --- Tier 5: Budget (always called — tracks total_events even when blocked) ---
    # When decision is "ask", skip counter increment to avoid phantom budget consumption
    # (user may deny the ask prompt, so the action never executes)
    _budget_skip_increment="false"
    [ "$BLOCK_DECISION" = "ask" ] && _budget_skip_increment="true"
    if ! budget_eval "$TOOL_INPUT" "$_NOW_EPOCH" "$BLOCKED" "" "$SESSION_ID" "$_budget_skip_increment"; then
      if [ "$BLOCKED" = false ]; then
        BLOCKED=true
        BLOCK_REASON="$BUDGET_REASON"
        BLOCK_HINT="${BUDGET_HINT:-}"
        BLOCK_DECISION="deny"
      fi
      # When the denial was a cumulative cap (vs per-session), forward the
      # signal into the trace so consumers see it alongside halted.json.
      if [ "$BUDGET_CUMULATIVE_HALTED" = "true" ]; then
        _TRACE_CUMULATIVE_HALTED="true"
        _TRACE_HALT_REASON="$BUDGET_REASON"
      fi
    fi
    _be_score=1; [ "$BUDGET_PASSED" = true ] && _be_score=0
    RESULTS+=("$(printf '{"name":"BudgetEvaluator","tier":5,"score":%d,"passed":%s,"detail":"%s"}' \
      "$_be_score" "$BUDGET_PASSED" "$(_json_escape "$BUDGET_REASON")")")

    # --- Tier 5.5: Context window saturation ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_CONTEXT_BUDGET_ENABLED" != "false" ]; then
      if declare -f context_budget_eval >/dev/null 2>&1; then
        if ! context_budget_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          if [ "$CONTEXT_BUDGET_DECISION" = "deny" ]; then
            BLOCKED=true
            BLOCK_REASON="$CONTEXT_BUDGET_REASON"
            BLOCK_HINT="${CONTEXT_BUDGET_HINT:-}"
            BLOCK_DECISION="deny"
          elif [ "$BLOCK_DECISION" = "ask" ]; then
            BLOCK_REASON="${BLOCK_REASON}; ${CONTEXT_BUDGET_REASON}"
            [ -z "$BLOCK_HINT" ] && BLOCK_HINT="${CONTEXT_BUDGET_HINT:-}"
          else
            BLOCK_DECISION="ask"
            BLOCK_REASON="$CONTEXT_BUDGET_REASON"
            BLOCK_HINT="${CONTEXT_BUDGET_HINT:-}"
          fi
        fi
        _cb_score="0.8"; [ "$CONTEXT_BUDGET_PASSED" = true ] && _cb_score="0"
        RESULTS+=("$(printf '{"name":"ContextBudgetEvaluator","tier":5.5,"score":%s,"passed":%s,"detail":"%s"}' \
          "$_cb_score" "$CONTEXT_BUDGET_PASSED" "$(_json_escape "$CONTEXT_BUDGET_REASON")")")
      fi
    fi

    # --- Tier 5.6: Cross-session governance ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_MULTI_SESSION_ENABLED" != "false" ]; then
      if declare -f multi_session_eval >/dev/null 2>&1; then
        if ! multi_session_eval "$TOOL_NAME" "$TOOL_INPUT"; then
          if [ "$BLOCK_DECISION" = "ask" ]; then
            BLOCK_REASON="${BLOCK_REASON}; ${MULTI_SESSION_REASON}"
            [ -z "$BLOCK_HINT" ] && BLOCK_HINT="${MULTI_SESSION_HINT:-}"
          else
            BLOCK_DECISION="ask"
            BLOCK_REASON="$MULTI_SESSION_REASON"
            BLOCK_HINT="${MULTI_SESSION_HINT:-}"
          fi
        fi
        _ms_score="0.7"; [ "$MULTI_SESSION_PASSED" = true ] && _ms_score="0"
        RESULTS+=("$(printf '{"name":"MultiSessionEvaluator","tier":5.6,"score":%s,"passed":%s,"detail":"%s"}' \
          "$_ms_score" "$MULTI_SESSION_PASSED" "$(_json_escape "$MULTI_SESSION_REASON")")")
      fi
    fi

    # --- Tier 6: Plugins ---
    if [ "$BLOCKED" = false ]; then
      PLUGIN_DIR="$LANEKEEP_DIR/plugins.d"
      if [ -d "$PLUGIN_DIR" ]; then
        # Use pre-extracted plugin hash allowlist from config (1A)
        _plugin_hashes="$_CFG_PLUGIN_HASHES"

        for plugin in "$PLUGIN_DIR"/*.plugin.sh "$PLUGIN_DIR"/*.plugin.py \
                     "$PLUGIN_DIR"/*.plugin.js "$PLUGIN_DIR"/*.plugin; do
          [ -f "$plugin" ] || continue
          if [ "$BLOCKED" = true ]; then break; fi

          # Plugin integrity check: verify hash if allowlist is configured
          if [ -n "$_plugin_hashes" ]; then
            _pname=$(basename "$plugin")

            # Use cached hash from lanekeep-serve startup (1D), or compute on the fly
            _phash=""
            if [ -n "${LANEKEEP_PLUGIN_HASHES:-}" ]; then
              IFS=';' read -ra _hash_entries <<< "$LANEKEEP_PLUGIN_HASHES"
              for _he in "${_hash_entries[@]}"; do
                if [ "${_he%%=*}" = "$_pname" ]; then
                  _phash="${_he#*=}"
                  break
                fi
              done
            fi
            [ -z "$_phash" ] && _phash=$(sha256sum "$plugin" 2>/dev/null | cut -d' ' -f1)

            # Look up expected hash from config allowlist
            _expected=""
            IFS=';' read -ra _allow_entries <<< "$_plugin_hashes"
            for _ae in "${_allow_entries[@]}"; do
              [ -z "$_ae" ] && continue
              if [ "${_ae%%=*}" = "$_pname" ]; then
                _expected="${_ae#*=}"
                break
              fi
            done
            if [ -z "$_expected" ]; then
              BLOCKED=true
              BLOCK_REASON="[LaneKeep] DENIED: Plugin not in hash allowlist: $_pname"
              BLOCK_DECISION="deny"
              RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":1.0,"passed":false,"detail":"Plugin not in hash allowlist, denied"}' "$(_json_escape "$_pname")")")
              break
            elif [ "$_phash" != "$_expected" ]; then
              BLOCKED=true
              BLOCK_REASON="[LaneKeep] DENIED: Plugin integrity check failed: $_pname (hash mismatch)"
              BLOCK_DECISION="deny"
              RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":1.0,"passed":false,"detail":"%s"}' \
                "$(_json_escape "$_pname")" "$(_json_escape "Hash mismatch: expected $_expected, got $_phash")")")
              break
            fi
          fi

          # Branch on plugin type: bash (.sh) vs polyglot (everything else)
          _pext="${plugin##*.plugin}"
          case "$_pext" in
            .sh)
              # Run bash plugin in subshell to isolate crashes
              plugin_result=$(
                # Scrub all env vars except safe list to prevent credential leakage
                while IFS='=' read -r _var _; do
                  case "$_var" in
                    HOME|PATH|SHELL|TERM|TMPDIR|LANG|LC_ALL) ;;
                    LANEKEEP_DIR|LANEKEEP_PLUGIN_EVALS|TOOL_NAME|TOOL_INPUT) ;;
                    _*) ;; # skip bash internals
                    *) unset "$_var" 2>/dev/null ;;
                  esac
                done < <(env)
                set +e
                source "$plugin" 2>/dev/null || { echo "CRASHED"; exit 0; }
                # Find registered eval function
                for func in $LANEKEEP_PLUGIN_EVALS; do
                  "$func" "$TOOL_NAME" "$TOOL_INPUT" 2>/dev/null
                  prefix="${func%_eval}"
                  prefix_upper=$(printf '%s' "$prefix" | tr '[:lower:]' '[:upper:]')
                  declare -n _p_ref="${prefix_upper}_PASSED" 2>/dev/null || true
                  declare -n _r_ref="${prefix_upper}_REASON" 2>/dev/null || true
                  declare -n _d_ref="${prefix_upper}_DECISION" 2>/dev/null || true
                  p="${_p_ref:-true}"
                  r="${_r_ref:-}"
                  d="${_d_ref:-deny}"
                  unset -n _p_ref _r_ref _d_ref
                  printf '%s\n%s\n%s\n%s\n' "$func" "$p" "$r" "$d"
                done
              ) 2>/dev/null || plugin_result="CRASHED"
              ;;
            *)
              # Polyglot: pipe JSON on stdin, read JSON on stdout
              if [ ! -x "$plugin" ]; then
                RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":0,"passed":true,"detail":"Plugin not executable, skipped"}' \
                  "$(_json_escape "$(basename "$plugin")")")")
                continue
              fi
              _poly_input=$(printf '{"tool_name":"%s","tool_input":%s}' \
                "$(_json_escape "$TOOL_NAME")" "$TOOL_INPUT")
              _plugin_timeout="${LANEKEEP_PLUGIN_TIMEOUT:-$_CFG_PLUGIN_TIMEOUT}"
              [[ "$_plugin_timeout" =~ ^[1-9][0-9]*$ ]] || _plugin_timeout=5
              plugin_result=$(printf '%s' "$_poly_input" | \
                env -i HOME="$HOME" PATH="$PATH" TMPDIR="${TMPDIR:-/tmp}" \
                timeout "$_plugin_timeout" "$plugin" 2>/dev/null) \
                || plugin_result="CRASHED"
              # Convert JSON response to 4-line format for existing parser
              if [ "$plugin_result" != "CRASHED" ] && [ -n "$plugin_result" ]; then
                plugin_result=$(printf '%s' "$plugin_result" | jq -r '
                  (.name // "polyglot"), (if .passed == false then "false" else "true" end),
                  ((.reason // "") | gsub("\n"; " ")), (.decision // "deny")' 2>/dev/null) || plugin_result="CRASHED"
              fi
              ;;
          esac

          if [ "$plugin_result" = "CRASHED" ] || [ -z "$plugin_result" ]; then
            # MED-04: Fail-closed on plugin crash (configurable via plugins.crash_policy)
            if [ "${_CFG_PLUGIN_CRASH_POLICY:-deny}" = "allow" ]; then
              RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":0,"passed":true,"detail":"Plugin crashed, skipped (crash_policy=allow)"}' \
                "$(_json_escape "$(basename "$plugin")")")")
            else
              BLOCKED=true
              BLOCK_REASON="[LaneKeep] DENIED: Plugin crashed or timed out: $(basename "$plugin")"
              BLOCK_DECISION="deny"
              RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":0.9,"passed":false,"detail":"Plugin crashed, denied (fail-closed)"}' \
                "$(_json_escape "$(basename "$plugin")")")")
              break
            fi
            continue
          fi

          # Parse results (each plugin func outputs 4 lines: name, passed, reason, decision)
          while IFS= read -r func_name && IFS= read -r p_passed && IFS= read -r p_reason && IFS= read -r p_decision; do
            [ -n "$func_name" ] || continue
            if [ "$p_passed" = "false" ]; then
              case "${p_decision:-deny}" in
                deny)
                  BLOCKED=true
                  BLOCK_REASON="$p_reason"
                  BLOCK_DECISION="deny"
                  ;;
                ask)
                  if [ "$BLOCKED" != true ]; then
                    if [ "$BLOCK_DECISION" = "ask" ]; then
                      # Aggregate "ask" reasons from multiple tiers
                      BLOCK_REASON="${BLOCK_REASON}; ${p_reason}"
                    else
                      BLOCK_DECISION="ask"
                      BLOCK_REASON="$p_reason"
                    fi
                  fi
                  ;;
                warn)
                  if [ -n "$WARN_REASON" ]; then
                    WARN_REASON="${WARN_REASON}; ${p_reason}"
                  else
                    WARN_REASON="$p_reason"
                  fi
                  ;;
              esac
            fi
            _p_score=0.9; [ "$p_passed" = "true" ] && _p_score=0
            RESULTS+=("$(printf '{"name":"Plugin:%s","tier":6,"score":%s,"passed":%s,"detail":"%s"}' \
              "$(_json_escape "$func_name")" "$_p_score" "$p_passed" "$(_json_escape "$p_reason")")")
          done <<< "$plugin_result"
        done
      fi
    fi

    # --- Tier 7: Semantic (LLM-based) ---
    if [ "$BLOCKED" = false ] && [ "$_CFG_SEMANTIC_ENABLED" != "false" ]; then
      if ! semantic_eval "$TOOL_NAME" "$TOOL_INPUT"; then
        BLOCKED=true
        BLOCK_REASON="$SEMANTIC_REASON"
        BLOCK_DECISION="deny"
      fi
      _sem_score=0.8; [ "$SEMANTIC_PASSED" = "true" ] && _sem_score=0
      RESULTS+=("$(printf '{"name":"SemanticEvaluator","tier":7,"score":%s,"passed":%s,"detail":"%s"}' \
        "$_sem_score" "$SEMANTIC_PASSED" "$(_json_escape "$SEMANTIC_REASON")")")
    fi

    # --- Dispatch decision ---
    _end_real=$EPOCHREALTIME; _end_sec=${_end_real%.*}; _end_usec=${_end_real#*.}
    END_NS="${_end_sec}${_end_usec}000"
    LATENCY_MS=$(( (END_NS - START_NS) / 1000000 ))

    if [ "$BLOCKED" = true ]; then
      DECISION="$BLOCK_DECISION"
      REASON=$(format_denial "$BLOCK_REASON" "${RESULTS[@]}")
    elif [ "$BLOCK_DECISION" = "ask" ]; then
      # Rules said "ask" but no plugin/semantic escalated to deny
      DECISION="ask"
      REASON=$(format_denial "$BLOCK_REASON" "${RESULTS[@]}")
    elif [ -n "$WARN_REASON" ]; then
      DECISION="warn"
      REASON="$WARN_REASON"
    else
      DECISION="allow"
      REASON=""
    fi

    # --- Cumulative risk scoring (session-scoped warn/ask escalation) ---
    # Opt-in via .evaluators.risk_score.enabled. Reads _SESSION_WARN_COUNT
    # and _SESSION_ASK_COUNT exposed by eval-budget.sh; escalates only when
    # the tentative decision is more permissive than the threshold implies,
    # never de-escalates. Ask threshold takes precedence over warn.
    if [ "$_CFG_RISK_ENABLED" = "true" ] && [ "$BLOCKED" = false ]; then
      _risk_total=$(( ${_SESSION_WARN_COUNT:-0} + ${_SESSION_ASK_COUNT:-0} ))
      _risk_escalated=false
      if [[ "$_CFG_RISK_ASK_THRESHOLD" =~ ^[0-9]+$ ]] \
          && [ "$_CFG_RISK_ASK_THRESHOLD" -gt 0 ] \
          && [ "$_risk_total" -ge "$_CFG_RISK_ASK_THRESHOLD" ] \
          && { [ "$DECISION" = "allow" ] || [ "$DECISION" = "warn" ]; }; then
        DECISION="ask"
        REASON="[LaneKeep] APPROVAL NEEDED — CumulativeRiskScoring
Session risk score elevated: ${_risk_total} warn/ask events so far (ask threshold ${_CFG_RISK_ASK_THRESHOLD}).
Repeated soft-gate events suggest the agent is probing boundaries or the plan is diverging."
        _risk_escalated=true
      elif [[ "$_CFG_RISK_WARN_THRESHOLD" =~ ^[0-9]+$ ]] \
          && [ "$_CFG_RISK_WARN_THRESHOLD" -gt 0 ] \
          && [ "$_risk_total" -ge "$_CFG_RISK_WARN_THRESHOLD" ] \
          && [ "$DECISION" = "allow" ]; then
        DECISION="warn"
        # WARN branch uses WARN_REASON (per the emission case below).
        WARN_REASON="[LaneKeep] WARNING — CumulativeRiskScoring: session at ${_risk_total} warn/ask events (warn threshold ${_CFG_RISK_WARN_THRESHOLD})."
        REASON="$WARN_REASON"
        _risk_escalated=true
      fi
      if [ "$_risk_escalated" = true ]; then
        RESULTS+=("$(printf '{"name":"CumulativeRiskScoring","tier":7.5,"score":0.6,"passed":false,"detail":"Session warn/ask total: %d","compliance":["CWE-770"]}' "$_risk_total")")
      fi
    fi

    # --- Headless escalation: rewrite ask -> deny + persist bundle ---
    _TRACE_ORIGINAL_DECISION=""
    if [ "$DECISION" = "ask" ] && headless::is_active; then
      _bundle_results="[$(IFS=,; printf '%s' "${RESULTS[*]:-}")]"
      _bundle_json=$(headless::_build_bundle \
        "$SESSION_ID" "$TOOL_NAME" "$TOOL_INPUT" \
        "$REASON" "$BLOCK_HINT" "$_bundle_results") || _bundle_json=""
      if [ -n "$_bundle_json" ]; then
        headless::write_bundle "$_bundle_json" "$SESSION_ID"
      fi
      _esc_path="$(headless::escalation_dir)/$(headless::escalation_id "$SESSION_ID").json"
      _TRACE_ORIGINAL_DECISION="ask"
      DECISION="deny"
      REASON="escalated (headless): see ${_esc_path}"
    fi

    # --- Return decision (before bookkeeping to avoid broken pipe under concurrency) ---
    case "$DECISION" in
      deny|ask)
        if [ -n "$BLOCK_HINT" ]; then
          printf '{"decision":"%s","reason":"%s","agent_hint":"%s"}\n' \
            "$DECISION" "$(_json_escape "$REASON")" "$(_json_escape "$BLOCK_HINT")"
        else
          printf '{"decision":"%s","reason":"%s"}\n' "$DECISION" "$(_json_escape "$REASON")"
        fi
        ;;
      warn)
        printf '{"decision":"warn","warn":"%s"}\n' "$(_json_escape "$WARN_REASON")"
        ;;
      *)
        echo '{"decision":"allow"}'
        ;;
    esac

    # Close stdout so socat delivers response immediately
    exec 1>&-

    # --- Write trace entry (pass cached timestamp) ---
    write_trace "$_NOW_ISO" "$TOOL_NAME" "$TOOL_INPUT" "$DECISION" "$REASON" "$LATENCY_MS" "PreToolUse" "$TOOL_USE_ID" "${RESULTS[@]}" || true

    # --- Cumulative risk scoring: increment session warn/ask counters ---
    # Runs after eval-budget has written state.json this cycle, so we
    # patch the field in place. Off-hot-path (post-response), tolerates
    # missing state file (early session), and skips lock acquisition
    # since state.json writes are serialized by the hook protocol.
    if [ "$_CFG_RISK_ENABLED" = "true" ] && [ -f "${LANEKEEP_STATE_FILE:-}" ]; then
      case "$DECISION" in
        warn|ask)
          _risk_field="${DECISION}_count"
          if jq --arg f "$_risk_field" '.[$f] = ((.[$f] // 0) + 1)' \
              "$LANEKEEP_STATE_FILE" > "${LANEKEEP_STATE_FILE}.tmp" 2>/dev/null; then
            mv "${LANEKEEP_STATE_FILE}.tmp" "$LANEKEEP_STATE_FILE"
          else
            rm -f "${LANEKEEP_STATE_FILE}.tmp"
          fi
          ;;
      esac
    fi

    # cumulative_record removed from hot path — qualitative metrics now derived from traces
    ;;

  PostToolUse)
    # === TIER 9: ResultTransform ===

    # Extract tool result text from various shapes
    TOOL_RESULT_TEXT=$(printf '%s' "$REQUEST" | jq -r '
      (.tool_response // .tool_result) |
      if type == "string" then .
      elif type == "array" then map(if type == "object" then (.text // .content // "") elif type == "string" then . else "" end) | join("\n")
      elif type == "object" then (.stdout // .content // .text // tostring)
      else tostring end' 2>/dev/null)

    # Detect user-denied ask: tool_response/tool_result is null/missing/empty
    _USER_DENIED="false"
    _tool_resp_type=$(printf '%s' "$REQUEST" | jq -r '
      (.tool_response // .tool_result) |
      if . == null then "null"
      elif . == "" then "empty"
      elif . == {} then "empty"
      elif type == "array" and length == 0 then "empty"
      else "present" end' 2>/dev/null)
    if [ "$_tool_resp_type" = "null" ] || [ "$_tool_resp_type" = "empty" ]; then
      _USER_DENIED="true"
    fi

    # Track output tokens in budget (tracking only, no denial — tool already ran)
    budget_eval "$TOOL_RESULT_TEXT" "$_NOW_EPOCH" "true" "output" "$SESSION_ID"

    # Run Tier 9 evaluator (skip if result_transform disabled)
    if [ "$_CFG_RESULT_TRANSFORM_ENABLED" != "false" ]; then
      result_transform_eval "$TOOL_NAME" "$TOOL_RESULT_TEXT" "$TOOL_INPUT" || true
    else
      RESULT_TRANSFORM_PASSED=true
      RESULT_TRANSFORM_REASON="Skipped (disabled)"
      RESULT_TRANSFORM_ACTION="allow"
      RESULT_TRANSFORM_COMPLIANCE="[]"
      RESULT_TRANSFORM_DETECTIONS="[]"
      RESULT_TRANSFORM_CONTENT=""
    fi

    RESULTS=()
    _rt_score=1; [ "$RESULT_TRANSFORM_PASSED" = "true" ] && _rt_score=0
    RESULTS+=("$(printf '{"name":"ResultTransform","tier":9,"score":%d,"passed":%s,"action":"%s","detail":"%s","compliance":%s,"detections":%s}' \
      "$_rt_score" "$RESULT_TRANSFORM_PASSED" "$(_json_escape "$RESULT_TRANSFORM_ACTION")" "$(_json_escape "$RESULT_TRANSFORM_REASON")" "$RESULT_TRANSFORM_COMPLIANCE" "$RESULT_TRANSFORM_DETECTIONS")")

    _end_real=$EPOCHREALTIME; _end_sec=${_end_real%.*}; _end_usec=${_end_real#*.}
    END_NS="${_end_sec}${_end_usec}000"
    LATENCY_MS=$(( (END_NS - START_NS) / 1000000 ))

    if [ "$RESULT_TRANSFORM_PASSED" = true ]; then
      DECISION="allow"
    else
      DECISION="deny"
    fi

    # --- Return response (before bookkeeping to avoid broken pipe under concurrency) ---
    if [ "$RESULT_TRANSFORM_ACTION" = "block" ]; then
      printf '{"decision":"deny","reason":"%s"}\n' "$(_json_escape "$RESULT_TRANSFORM_REASON")"
    elif [ "$RESULT_TRANSFORM_ACTION" = "warn" ]; then
      printf '{"decision":"allow","warn":"%s"}\n' "$(_json_escape "$RESULT_TRANSFORM_REASON")"
    elif [ "$RESULT_TRANSFORM_ACTION" = "redact" ] && [ -n "$RESULT_TRANSFORM_CONTENT" ]; then
      # Use jq to JSON-encode: transformed tool output may contain raw control bytes
      # (0x00–0x1F, e.g. ANSI escapes) that _json_escape does not handle, which
      # would produce a malformed response and trip the hook's fail-closed branch.
      jq -n -c \
        --arg warn "$RESULT_TRANSFORM_REASON" \
        --arg content "$RESULT_TRANSFORM_CONTENT" \
        '{decision:"allow",warn:$warn,transformed_content:$content}'
    else
      echo '{"decision":"allow"}'
    fi

    # Close stdout so socat delivers response immediately
    exec 1>&-

    # --- Write trace entry (pass cached timestamp) ---
    _TRACE_USER_DENIED="$_USER_DENIED"
    write_trace "$_NOW_ISO" "$TOOL_NAME" "$TOOL_INPUT" "$DECISION" "$RESULT_TRANSFORM_REASON" "$LATENCY_MS" "PostToolUse" "$TOOL_USE_ID" "${RESULTS[@]}" || true

    ;;

  *)
    # Security: unknown hook events must NOT bypass the pipeline
    echo '{"decision":"deny","reason":"[LaneKeep] Unknown hook event type: '"$HOOK_EVENT"'"}'
    ;;
esac
